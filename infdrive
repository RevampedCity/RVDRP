-- =========================
-- SETTINGS
-- =========================
local startPosition = Vector3.new(-19125, 1276, 14726)
local endPosition = Vector3.new(709, 868, -6331)

local driveSpeed = 220
local driveDuration = 30

local comboToken = 0
local bankToken = 0

local comboEnabled = false
local bankEnabled = false

local storeCooldown = 60
local storeCooldowns = {}

local driveConnection
local currentVelocity
local currentAttachment
local antiAfkConnection

local savedCar
local savedSeat

local RobLocations = {
    {Name = "Gas Station", CFrame = CFrame.new(-8, -6, -4389)},
    {Name = "ATM 1", CFrame = CFrame.new(-1258, -6, -4507)},
    {Name = "Hospital ATM", CFrame = CFrame.new(-217, -6, -3515)},
    {Name = "McDonalds", CFrame = CFrame.new(-31, -6, -2902)},
    {Name = "Nowhere ATM", CFrame = CFrame.new(646, -7, -5350)}
}

local SELL_CFRAME = CFrame.new(-4387, -7, -2324)

-- =========================
-- HELPERS
-- =========================
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHum()
    return getChar():WaitForChild("Humanoid")
end

local function getHRP()
    return getChar():WaitForChild("HumanoidRootPart")
end

local function enableAntiAfk()
    if antiAfkConnection then return end
    antiAfkConnection = LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function disableAntiAfk()
    if antiAfkConnection then
        antiAfkConnection:Disconnect()
        antiAfkConnection = nil
    end
end

local function stopPart(part)
    if part then
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end
end

local function stopCar(car)
    if not car then return end

    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            stopPart(part)
        end
    end
end

local function getPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then return obj:GetPivot().Position end
    if obj:IsA("Attachment") then return obj.WorldPosition end
    if obj.Parent then return getPosition(obj.Parent) end
end

local function playerTP(cf)
    local hum = getHum()
    local hrp = getHRP()

    hum.Sit = false
    task.wait(0.15)

    hum:ChangeState(0)
    repeat task.wait() until not LocalPlayer:GetAttribute("LastACPos")

    hrp.CFrame = cf
    stopPart(hrp)
end

local function holdE(duration)
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(duration)
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function firePrompt(prompt)
    if not prompt then return end
    pcall(function()
        prompt.HoldDuration = 0
        fireproximityprompt(prompt)
    end)
end

-- =========================
-- CAR SPAWN + AIR DRIVE
-- =========================
local function getVehicleSeat()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = hum and hum.SeatPart

    if seat and seat:IsA("VehicleSeat") then
        return seat
    end
end

local function getCurrentCar()
    local seat = getVehicleSeat()
    if not seat then return nil, nil end

    local car = seat:FindFirstAncestorOfClass("Model")
    return car, seat
end

local function sitInSeat(seat)
    if not seat or not seat.Parent then return false end

    local hum = getHum()
    local hrp = getHRP()

    hrp.CFrame = CFrame.new(seat.Position + Vector3.new(0, 4, 0))
    task.wait(0.3)

    pcall(function()
        seat:Sit(hum)
    end)

    task.wait(0.5)
    return hum.SeatPart == seat
end

local function spawnTrackhawkOnUser()
    local hrp = getHRP()
    local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -8)

    local args = {
        "SUVs",
        "2018 GEEP Grand Cherokee SRT Trackhawk",
        spawnCFrame
    }

    pcall(function()
        ReplicatedStorage.Events.Dealership.RequestSpawn:InvokeServer(unpack(args))
    end)

    task.wait(1.5)

    local closestCar
    local closestSeat
    local closestDist = 200

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            local car = obj:FindFirstAncestorOfClass("Model")
            local dist = (obj.Position - spawnCFrame.Position).Magnitude

            if car and dist < closestDist then
                closestDist = dist
                closestCar = car
                closestSeat = obj
            end
        end
    end

    if closestCar and closestSeat then
        savedCar = closestCar
        savedSeat = closestSeat
        sitInSeat(closestSeat)
        return closestCar, closestSeat
    end
end

local function ensureCar()
    local car, seat = getCurrentCar()

    if car and seat then
        savedCar = car
        savedSeat = seat
        return car, seat
    end

    if savedCar and savedSeat and savedCar.Parent and savedSeat.Parent then
        if sitInSeat(savedSeat) then
            return savedCar, savedSeat
        end
    end

    return spawnTrackhawkOnUser()
end

local function cleanupDrive()
    if driveConnection then
        driveConnection:Disconnect()
        driveConnection = nil
    end

    if currentVelocity then
        currentVelocity:Destroy()
        currentVelocity = nil
    end

    if currentAttachment then
        currentAttachment:Destroy()
        currentAttachment = nil
    end
end

local function runAirDriveFor30(token)
    if token ~= comboToken then return end

    local car, seat = ensureCar()
    if not car or not seat then return end

    local rootPart = car.PrimaryPart or seat
    car.PrimaryPart = rootPart

    cleanupDrive()

    local direction = (endPosition - startPosition).Unit
    local startCFrame = CFrame.new(startPosition, startPosition + direction)

    car:PivotTo(startCFrame)
    task.wait(0.2)

    currentAttachment = Instance.new("Attachment")
    currentAttachment.Parent = rootPart

    currentVelocity = Instance.new("LinearVelocity")
    currentVelocity.Attachment0 = currentAttachment
    currentVelocity.MaxForce = math.huge
    currentVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    currentVelocity.VectorVelocity = direction * driveSpeed
    currentVelocity.Parent = rootPart

    pcall(function()
        seat.ThrottleFloat = 1
    end)

    local startTime = tick()

    driveConnection = RunService.Heartbeat:Connect(function()
        if token ~= comboToken then
            cleanupDrive()
            stopCar(car)
            return
        end

        if tick() - startTime >= driveDuration then
            cleanupDrive()
            stopCar(car)
            return
        end

        if (rootPart.Position - endPosition).Magnitude <= 80 then
            car:PivotTo(startCFrame)

            for _, part in ipairs(car:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = direction * driveSpeed
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        if currentVelocity then
            currentVelocity.VectorVelocity = direction * driveSpeed
        end
    end)

    while token == comboToken and tick() - startTime < driveDuration do
        task.wait(0.2)
    end

    cleanupDrive()
    stopCar(car)

    pcall(function()
        seat.ThrottleFloat = 0
    end)
end

-- =========================
-- SMALL STORES FARM
-- =========================
local function getNearbyPrompt(root, radius)
    local closest
    local closestDist = radius or 25

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local pos = getPosition(obj)

            if pos then
                local dist = (pos - root.Position).Magnitude
                if dist <= closestDist then
                    closestDist = dist
                    closest = obj
                end
            end
        end
    end

    return closest
end

local function pickupMoneyFast(radius)
    local root = getHRP()
    local center = root.Position
    local gotMoney = false
    local lastPickup = tick()

    while tick() - lastPickup < 0.8 do
        local found = false

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local parent = obj.Parent
                local pos = getPosition(obj)

                if parent and pos then
                    local name = parent.Name:lower()
                    local isCash =
                        name:find("money")
                        or name:find("cash")
                        or name:find("bill")
                        or name:find("bag")
                        or name:find("loot")

                    if isCash and (pos - center).Magnitude <= radius then
                        root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                        stopPart(root)
                        task.wait(0.06)

                        holdE(math.max(obj.HoldDuration + 0.05, 0.25))

                        found = true
                        gotMoney = true
                        lastPickup = tick()
                    end
                end
            end
        end

        if not found then
            task.wait(0.08)
        end
    end

    return gotMoney
end

local function runSmallStoresOnce(token)
    -- car stays where it is; player exits and teleports alone
    local hum = getHum()
    hum.Sit = false
    task.wait(0.2)

    for _, loc in ipairs(RobLocations) do
        if token ~= comboToken then return end

        local cooldownEnd = storeCooldowns[loc.Name]
        if cooldownEnd and os.time() < cooldownEnd then
            continue
        end

        playerTP(loc.CFrame)
        task.wait(0.45)

        local root = getHRP()
        local prompt = getNearbyPrompt(root, 25)

        if not prompt then
            storeCooldowns[loc.Name] = os.time() + storeCooldown
            continue
        end

        firePrompt(prompt)
        holdE(10.5)
        task.wait(0.3)

        local gotMoney = pickupMoneyFast(50)
        storeCooldowns[loc.Name] = os.time() + storeCooldown

        if gotMoney and token == comboToken then
            playerTP(SELL_CFRAME * CFrame.new(0, 8, 0))
            task.wait(0.25)
            playerTP(SELL_CFRAME)
            task.wait(1.2)
        end
    end
end

-- =========================
-- BANK FARM
-- =========================
local function bankReady()
    local cooldown = workspace.Systems.Bank.CooldownTimer
    return #cooldown:GetChildren() == 0
end

local function isGreen(part)
    local c = part.Color

    return math.floor(c.R * 255 + 0.5) == 40
        and math.floor(c.G * 255 + 0.5) == 127
        and math.floor(c.B * 255 + 0.5) == 71
end

local function hackDoor(prompt, part, token)
    while token == bankToken and bankEnabled and prompt and prompt.Parent do
        if isGreen(part) then
            firePrompt(prompt)
            task.wait(0.6)
        else
            task.wait(0.1)
        end
    end
end

local function buyBomb()
    local args = {
        workspace.Systems.Criminal.Dealer,
        "Buy",
        "Bomb"
    }

    ReplicatedStorage.Events.Criminal.Dealer:FireServer(unpack(args))
end

local function collectBankLoot(token)
    local room = workspace.Systems.Bank.Loot.MainRoom

    for _, v in ipairs(room:GetDescendants()) do
        if token ~= bankToken or not bankEnabled then return end

        if v:IsA("ProximityPrompt") and v.Name == "CollectLoot" then
            local pos = getPosition(v)
            if pos then
                playerTP(CFrame.new(pos + Vector3.new(0, 3, 0)))
                task.wait(0.15)
                firePrompt(v)
            end
        end
    end
end

local function bankLoop(token)
    while token == bankToken and bankEnabled do
        if not bankReady() then
            task.wait(1)
            continue
        end

        local dealer
        for _, v in ipairs(workspace.Map:GetChildren()) do
            if v.Name:lower():find("gun dealer") then
                dealer = v
                break
            end
        end

        if not dealer then return end

        playerTP(dealer:GetPivot() + Vector3.new(0, 2, 0))
        task.wait(1)
        buyBomb()
        task.wait(1.5)

        local vault = workspace.Systems.Bank.VaultDoor
        playerTP(vault:GetPivot())
        task.wait(0.4)

        firePrompt(vault.C4Attach.PlaceC4)
        task.wait(10)

        local mini = workspace.Systems.Bank.Minigames:GetChildren()[2]
        playerTP(CFrame.new(mini.DirectionPart.Position + Vector3.new(0, 3, 0)))
        hackDoor(mini.HackDoorPrompt, mini.DirectionPart, token)

        collectBankLoot(token)

        local door = workspace.Systems.Bank.Minigames.Door
        playerTP(CFrame.new(door.DirectionPart.Position + Vector3.new(0, 3, 0)))
        hackDoor(door.HackDoorPrompt, door.DirectionPart, token)

        task.wait(2)
    end
end

-- =========================
-- LOOPS
-- =========================
local function comboLoop(token)
    enableAntiAfk()

    while token == comboToken and comboEnabled do
        runSmallStoresOnce(token)

        if token ~= comboToken or not comboEnabled then break end

        runAirDriveFor30(token)

        task.wait(0.25)
    end

    cleanupDrive()
    disableAntiAfk()

    if savedCar then
        stopCar(savedCar)
    end
end

