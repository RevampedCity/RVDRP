-- SHAMAN LIB
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/RevampedCity/Shaman-Library/refs/heads/main/Library"))()
local Window = Library:Window({ Text = "Shaman Farm" })

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer

local MainTab = Window:Tab({ Text = "Main" })
local DriveSection = MainTab:Section({ Text = "Air Drive" })
local FarmSection = MainTab:Section({ Text = "Money Farm" })

local startPosition = Vector3.new(-19125, 1276, 14726)
local endPosition = Vector3.new(709, 868, -6331)

local driveSpeed = 220
local enabledDrive = false
local enabledFarm = false
local farmToken = 0

local COOLDOWN = 60
local cooldowns = {}

local driveConnection
local currentVelocity
local currentAttachment
local antiAfkConnection

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getPosition(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Model") then
        return obj:GetPivot().Position
    end

    if obj:IsA("Attachment") then
        return obj.WorldPosition
    end

    if obj.Parent then
        return getPosition(obj.Parent)
    end

    return nil
end

local function isInsideRobberies(obj)
    local robberies = workspace:FindFirstChild("Systems")
        and workspace.Systems:FindFirstChild("Robberies")

    local current = obj
    while current do
        if current == robberies then
            return true
        end
        current = current.Parent
    end

    return false
end

local function getRobberyPrompts()
    local rob = workspace:FindFirstChild("Systems")
        and workspace.Systems:FindFirstChild("Robberies")

    if not rob then return {} end

    local list = {}

    local mcKebab = rob:FindFirstChild("Mc Kebab")
    if mcKebab then
        local prompt = mcKebab:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then table.insert(list, prompt) end
    end

    local lovies = rob:FindFirstChild("Lovies")
    if lovies then
        local prompt = lovies:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then table.insert(list, prompt) end
    end

    for i = 1, 5 do
        local atm = rob:FindFirstChild("ATM " .. i)
        if atm then
            local prompt = atm:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then table.insert(list, prompt) end
        end
    end

    return list
end

local function teleportToPosition(pos, token)
    if token and (not enabledFarm or token ~= farmToken) then return false end
    if not pos then return false end

    local char = getCharacter()
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not hum or not hrp then return false end

    hum:ChangeState(0)

    repeat
        task.wait()
        if token and (not enabledFarm or token ~= farmToken) then return false end
    until not LocalPlayer:GetAttribute("LastACPos")

    if token and (not enabledFarm or token ~= farmToken) then return false end

    hrp.CFrame = CFrame.new(pos)
    return true
end

local function teleportToPrompt(prompt, token)
    local pos = getPosition(prompt)
    if not pos then return false end
    return teleportToPosition(pos + Vector3.new(0, 3, 0), token)
end

local function getVehicleSeat()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = hum and hum.SeatPart

    if seat and seat:IsA("VehicleSeat") then
        return seat
    end

    return nil
end

local function getCar()
    local seat = getVehicleSeat()
    if not seat then return nil, nil end

    local car = seat:FindFirstAncestorOfClass("Model")
    return car, seat
end

local function stopCar(car)
    if not car then return end

    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function cleanupDrive()
    if driveConnection then
        driveConnection:Disconnect()
        driveConnection = nil
    end

    if currentVelocity then
        currentVelocity:Destroy()
        currentVelocity = nil
    end

    if currentAttachment then
        currentAttachment:Destroy()
        currentAttachment = nil
    end
end

local function enableAntiAfk()
    if antiAfkConnection then return end

    antiAfkConnection = LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function disableAntiAfk()
    if antiAfkConnection then
        antiAfkConnection:Disconnect()
        antiAfkConnection = nil
    end
end

local function getDirection()
    return (endPosition - startPosition).Unit
end

local function getStartCFrame()
    local direction = getDirection()
    return CFrame.new(startPosition, startPosition + direction)
end

local function startDrive()
    local car, seat = getCar()
    if not car or not seat then
        warn("Get in a car first.")
        return
    end

    local rootPart = car.PrimaryPart or seat
    car.PrimaryPart = rootPart

    cleanupDrive()

    local direction = getDirection()

    car:PivotTo(getStartCFrame())
    task.wait(0.2)

    currentAttachment = Instance.new("Attachment")
    currentAttachment.Name = "SmoothDriveAttachment"
    currentAttachment.Parent = rootPart

    currentVelocity = Instance.new("LinearVelocity")
    currentVelocity.Name = "SmoothMapDriveVelocity"
    currentVelocity.Attachment0 = currentAttachment
    currentVelocity.MaxForce = math.huge
    currentVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    currentVelocity.VectorVelocity = direction * driveSpeed
    currentVelocity.Parent = rootPart

    pcall(function()
        seat.ThrottleFloat = 1
    end)

    driveConnection = RunService.Heartbeat:Connect(function()
        if not enabledDrive then
            cleanupDrive()
            stopCar(car)
            disableAntiAfk()

            pcall(function()
                seat.ThrottleFloat = 0
            end)

            return
        end

        if not car or not car.Parent or not rootPart or not rootPart.Parent then
            cleanupDrive()
            disableAntiAfk()
            return
        end

        local distanceToEnd = (rootPart.Position - endPosition).Magnitude

        if distanceToEnd <= 80 then
            car:PivotTo(getStartCFrame())

            for _, part in ipairs(car:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = direction * driveSpeed
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        if currentVelocity then
            currentVelocity.VectorVelocity = direction * driveSpeed
        end
    end)
end

local function firePrompt(prompt, token)
    if token and (not enabledFarm or token ~= farmToken) then return false end
    if not prompt or not prompt.Parent then return false end

    prompt.HoldDuration = 0

    pcall(function()
        fireproximityprompt(prompt)
    end)

    return true
end

local function isMoneyPrompt(prompt, origin, ignorePrompt)
    if not prompt or not prompt.Parent then return false end
    if prompt == ignorePrompt then return false end
    if isInsideRobberies(prompt) then return false end

    local pos = getPosition(prompt)
    if not pos then return false end

    return (pos - origin).Magnitude <= 65
end

local function waitForMoneyDrop(origin, ignorePrompt, token)
    local started = tick()

    while enabledFarm and token == farmToken and tick() - started < 1.8 do
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if not enabledFarm or token ~= farmToken then return false end

            if prompt:IsA("ProximityPrompt") and isMoneyPrompt(prompt, origin, ignorePrompt) then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

local function collectAllMoney(origin, ignorePrompt, token)
    local gotAny = false
    local lastFound = tick()

    while enabledFarm and token == farmToken do
        local foundThisPass = false

        for _, prompt in ipairs(workspace:GetDescendants()) do
            if not enabledFarm or token ~= farmToken then return gotAny end

            if prompt:IsA("ProximityPrompt") and isMoneyPrompt(prompt, origin, ignorePrompt) then
                local pos = getPosition(prompt)

                if pos then
                    teleportToPosition(pos + Vector3.new(0, 3, 0), token)
                    if not enabledFarm or token ~= farmToken then return gotAny end

                    task.wait(0.12)
                    firePrompt(prompt, token)

                    foundThisPass = true
                    gotAny = true
                    lastFound = tick()

                    task.wait(0.18)
                end
            end
        end

        if not foundThisPass and tick() - lastFound > 0.7 then
            break
        end

        task.wait(0.1)
    end

    return gotAny
end

local function farmLoop(token)
    while enabledFarm and token == farmToken do
        local car, seat = getCar()

        if car then
            stopCar(car)
        end

        local prompts = getRobberyPrompts()

        for _, robberyPrompt in ipairs(prompts) do
            if not enabledFarm or token ~= farmToken then return end
            if not robberyPrompt or not robberyPrompt.Parent then continue end

            local origin = getPosition(robberyPrompt)
            if not origin then continue end

            local last = cooldowns[robberyPrompt]
            if last and tick() - last < COOLDOWN then
                continue
            end

            local teleported = teleportToPrompt(robberyPrompt, token)
            if not teleported then return end

            task.wait(0.25)
            if not enabledFarm or token ~= farmToken then return end

            firePrompt(robberyPrompt, token)

            local dropped = waitForMoneyDrop(origin, robberyPrompt, token)

            if not dropped then
                continue
            end

            local gotMoney = collectAllMoney(origin, robberyPrompt, token)

            if gotMoney then
                cooldowns[robberyPrompt] = tick()
            end
        end

        if enabledFarm and token == farmToken and seat and seat.Parent then
            local seatPos = getPosition(seat)
            if seatPos then
                teleportToPosition(seatPos + Vector3.new(0, 3, 0), token)
            end
        end

        task.wait(0.5)
    end
end

DriveSection:Toggle({
    Text = "Air Drive",
    Default = false,
    Callback = function(state)
        enabledDrive = state

        if state then
            enableAntiAfk()
            startDrive()
        else
            cleanupDrive()
            disableAntiAfk()

            local car = select(1, getCar())
            if car then
                stopCar(car)
            end
        end
    end
})

DriveSection:Slider({
    Text = "Speed",
    Default = 220,
    Minimum = 80,
    Maximum = 880,
    Callback = function(value)
        driveSpeed = value
    end
})

FarmSection:Toggle({
    Text = "ATM + Gas Farm",
    Default = false,
    Callback = function(state)
        enabledFarm = state
        farmToken += 1

        if state then
            task.spawn(function()
                farmLoop(farmToken)
            end)
        end
    end
})
