-- SHAMAN LIB
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/RevampedCity/Shaman-Library/refs/heads/main/Library"))()
local Window = Library:Window({ Text = "Shaman Farm" })

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local MainTab = Window:Tab({ Text = "Main" })
local ComboSection = MainTab:Section({ Text = "Combo Farm" })

-- POINTS
local startPosition = Vector3.new(-19125, 1276, 14726)
local endPosition = Vector3.new(709, 868, -6331)

-- SETTINGS
local driveSpeed = 220
local driveDuration = 30
local COOLDOWN = 60

local comboEnabled = false
local comboToken = 0
local cooldowns = {}

local driveConnection
local currentVelocity
local currentAttachment
local antiAfkConnection

local savedCar
local savedSeat

-- =========================
-- BASIC HELPERS
-- =========================
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    return getCharacter():WaitForChild("Humanoid")
end

local function getHRP()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

local function getPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then return obj:GetPivot().Position end
    if obj:IsA("Attachment") then return obj.WorldPosition end
    if obj.Parent then return getPosition(obj.Parent) end
    return nil
end

local function teleport(pos, token)
    if token ~= comboToken then return false end

    local hum = getHumanoid()
    local hrp = getHRP()

    hum:ChangeState(0)

    repeat
        task.wait()
        if token ~= comboToken then return false end
    until not LocalPlayer:GetAttribute("LastACPos")

    if token ~= comboToken then return false end

    hrp.CFrame = CFrame.new(pos)
    return true
end

local function firePrompt(prompt)
    if not prompt then return end

    pcall(function()
        prompt.HoldDuration = 0
        fireproximityprompt(prompt)
    end)
end

local function enableAntiAfk()
    if antiAfkConnection then return end

    antiAfkConnection = LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function disableAntiAfk()
    if antiAfkConnection then
        antiAfkConnection:Disconnect()
        antiAfkConnection = nil
    end
end

-- =========================
-- VEHICLE SPAWN + SIT
-- =========================
local function spawnTrackhawkOnUser()
    local hrp = getHRP()
    local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -8)

    local args = {
        "SUVs",
        "2018 GEEP Grand Cherokee SRT Trackhawk",
        spawnCFrame
    }

    pcall(function()
        ReplicatedStorage
            :WaitForChild("Events")
            :WaitForChild("Dealership")
            :WaitForChild("RequestSpawn")
            :InvokeServer(unpack(args))
    end)

    task.wait(2)

    local closestCar
    local closestSeat
    local closestDist = 200

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            local car = obj:FindFirstAncestorOfClass("Model")
            local dist = (obj.Position - spawnCFrame.Position).Magnitude

            if car and dist < closestDist then
                closestDist = dist
                closestCar = car
                closestSeat = obj
            end
        end
    end

    if closestCar and closestSeat then
        savedCar = closestCar
        savedSeat = closestSeat
        return closestCar, closestSeat
    end

    return nil, nil
end

local function getVehicleSeat()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = hum and hum.SeatPart

    if seat and seat:IsA("VehicleSeat") then
        return seat
    end

    return nil
end

local function getCurrentCar()
    local seat = getVehicleSeat()
    if not seat then return nil, nil end

    local car = seat:FindFirstAncestorOfClass("Model")
    return car, seat
end

local function sitInSeat(seat)
    if not seat or not seat.Parent then return false end

    local hum = getHumanoid()
    local hrp = getHRP()

    hrp.CFrame = CFrame.new(seat.Position + Vector3.new(0, 4, 0))
    task.wait(0.3)

    pcall(function()
        seat:Sit(hum)
    end)

    task.wait(0.6)

    return hum.SeatPart == seat
end

local function ensureCar()
    local car, seat = getCurrentCar()

    if car and seat then
        savedCar = car
        savedSeat = seat
        return car, seat
    end

    if savedCar and savedSeat and savedCar.Parent and savedSeat.Parent then
        if sitInSeat(savedSeat) then
            return savedCar, savedSeat
        end
    end

    car, seat = spawnTrackhawkOnUser()

    if car and seat then
        sitInSeat(seat)
        return car, seat
    end

    return nil, nil
end

local function stopCar(car)
    if not car then return end

    for _, part in ipairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function cleanupDrive()
    if driveConnection then
        driveConnection:Disconnect()
        driveConnection = nil
    end

    if currentVelocity then
        currentVelocity:Destroy()
        currentVelocity = nil
    end

    if currentAttachment then
        currentAttachment:Destroy()
        currentAttachment = nil
    end
end

-- =========================
-- AIR DRIVE 30 SECONDS
-- =========================
local function getDirection()
    return (endPosition - startPosition).Unit
end

local function getStartCFrame()
    local direction = getDirection()
    return CFrame.new(startPosition, startPosition + direction)
end

local function runAirDriveFor30(token)
    if token ~= comboToken then return end

    local car, seat = ensureCar()
    if not car or not seat then
        warn("No car found/spawned.")
        return
    end

    local rootPart = car.PrimaryPart or seat
    car.PrimaryPart = rootPart

    cleanupDrive()

    local direction = getDirection()

    car:PivotTo(getStartCFrame())
    task.wait(0.2)

    currentAttachment = Instance.new("Attachment")
    currentAttachment.Name = "SmoothDriveAttachment"
    currentAttachment.Parent = rootPart

    currentVelocity = Instance.new("LinearVelocity")
    currentVelocity.Name = "SmoothMapDriveVelocity"
    currentVelocity.Attachment0 = currentAttachment
    currentVelocity.MaxForce = math.huge
    currentVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    currentVelocity.VectorVelocity = direction * driveSpeed
    currentVelocity.Parent = rootPart

    pcall(function()
        seat.ThrottleFloat = 1
    end)

    local startTime = tick()

    driveConnection = RunService.Heartbeat:Connect(function()
        if token ~= comboToken then
            cleanupDrive()
            stopCar(car)

            pcall(function()
                seat.ThrottleFloat = 0
            end)

            return
        end

        if not car or not car.Parent or not rootPart or not rootPart.Parent then
            cleanupDrive()
            return
        end

        if tick() - startTime >= driveDuration then
            cleanupDrive()
            stopCar(car)

            pcall(function()
                seat.ThrottleFloat = 0
            end)

            return
        end

        local distanceToEnd = (rootPart.Position - endPosition).Magnitude

        if distanceToEnd <= 80 then
            car:PivotTo(getStartCFrame())

            for _, part in ipairs(car:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = direction * driveSpeed
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        if currentVelocity then
            currentVelocity.VectorVelocity = direction * driveSpeed
        end
    end)

    while token == comboToken and tick() - startTime < driveDuration do
        task.wait(0.2)
    end

    cleanupDrive()
    stopCar(car)

    pcall(function()
        seat.ThrottleFloat = 0
    end)
end

-- =========================
-- ROBBERY PROMPTS
-- =========================
local function getRobberyPrompts()
    local rob = workspace:FindFirstChild("Systems")
        and workspace.Systems:FindFirstChild("Robberies")

    if not rob then return {} end

    local list = {}

    local kebab = rob:FindFirstChild("Mc Kebab")
    if kebab then
        local p = kebab:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p then table.insert(list, p) end
    end

    local lovies = rob:FindFirstChild("Lovies")
    if lovies then
        local p = lovies:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p then table.insert(list, p) end
    end

    for i = 1, 5 do
        local atm = rob:FindFirstChild("ATM " .. i)
        if atm then
            local p = atm:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p then table.insert(list, p) end
        end
    end

    return list
end

local function isInsideRobberies(obj)
    local rob = workspace:FindFirstChild("Systems")
        and workspace.Systems:FindFirstChild("Robberies")

    local cur = obj
    while cur do
        if cur == rob then return true end
        cur = cur.Parent
    end

    return false
end

local function countNoCash()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return 0 end

    local count = 0

    for _, v in ipairs(gui:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            if tostring(v.Text):lower():find("no cash left") then
                count += 1
            end
        end
    end

    return count
end

local function waitForNewNoCash(oldCount, token)
    local start = tick()

    while tick() - start < 1 do
        if token ~= comboToken then return false end

        if countNoCash() > oldCount then
            return true
        end

        task.wait(0.1)
    end

    return false
end

local function isMoneyPrompt(prompt, origin, ignore)
    if not prompt or not prompt.Parent then return false end
    if prompt == ignore then return false end
    if isInsideRobberies(prompt) then return false end

    local pos = getPosition(prompt)
    if not pos then return false end

    return (pos - origin).Magnitude <= 70
end

local function waitForMoney(origin, ignore, token)
    local start = tick()

    while tick() - start < 2 do
        if token ~= comboToken then return false end

        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and isMoneyPrompt(prompt, origin, ignore) then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

local function collectMoney(origin, ignore, token)
    local got = false
    local last = tick()

    while tick() - last < 0.8 do
        if token ~= comboToken then return got end

        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and isMoneyPrompt(prompt, origin, ignore) then
                local pos = getPosition(prompt)

                if pos then
                    teleport(pos + Vector3.new(0, 3, 0), token)
                    task.wait(0.1)
                    firePrompt(prompt)

                    got = true
                    last = tick()
                end
            end
        end

        task.wait(0.1)
    end

    return got
end

-- =========================
-- RUN ALL ROBBERIES ONCE
-- =========================
local function runRobberiesOnce(token)
    local prompts = getRobberyPrompts()

    for _, prompt in ipairs(prompts) do
        if token ~= comboToken then return end
        if not prompt or not prompt.Parent then continue end

        local pos = getPosition(prompt)
        if not pos then continue end

        local last = cooldowns[prompt]
        if last and tick() - last < COOLDOWN then
            continue
        end

        local oldNoCash = countNoCash()

        teleport(pos + Vector3.new(0, 3, 0), token)
        task.wait(0.2)

        firePrompt(prompt)

        if waitForNewNoCash(oldNoCash, token) then
            cooldowns[prompt] = tick()
            continue
        end

        local dropped = waitForMoney(pos, prompt, token)

        if not dropped then
            cooldowns[prompt] = tick()
            continue
        end

        collectMoney(pos, prompt, token)
        cooldowns[prompt] = tick()
    end
end

-- =========================
-- COMBO LOOP
-- =========================
local function comboLoop(token)
    enableAntiAfk()

    while token == comboToken do
        -- 1. Run all ATM/Gas first
        runRobberiesOnce(token)

        if token ~= comboToken then break end

        -- 2. Then do car for 30 seconds
        runAirDriveFor30(token)

        if token ~= comboToken then break end

        task.wait(0.5)
    end

    cleanupDrive()
    disableAntiAfk()

    if savedCar then
        stopCar(savedCar)
    end
end

